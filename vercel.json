{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-audit --no-fund && cd web && npm install --no-audit --no-fund",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/auth/ativar", "destination": "/index.html" },
    { "source": "/((?!api/|assets/|manifest.webmanifest|sw.js|favicon.ico).*)", "destination": "/index.html" }
  ]
}
